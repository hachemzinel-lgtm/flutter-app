rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUid() {
      return request.auth.uid;
    }

    function isOwner(userId) {
      return isSignedIn() && currentUid() == userId;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(currentUid()));
    }

    function userType(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.accountType;
    }

    function hasParticipantAccess(participants) {
      return isSignedIn() && currentUid() in participants;
    }

    function isWorkProviderType(typeValue) {
      return typeValue == 'workProvider' || typeValue == 'work_provider';
    }

    function isAllowedConversationPair(participants) {
      return participants.size() == 2 &&
        participants[0] != participants[1] &&
        (
          (userType(participants[0]) == 'client' &&
            (isWorkProviderType(userType(participants[1])) || userType(participants[1]) == 'marketplace')) ||
          (userType(participants[1]) == 'client' &&
            (isWorkProviderType(userType(participants[0])) || userType(participants[0]) == 'marketplace')) ||
          (isWorkProviderType(userType(participants[0])) && userType(participants[1]) == 'marketplace') ||
          (isWorkProviderType(userType(participants[1])) && userType(participants[0]) == 'marketplace')
        );
    }

    // ✅ FIXED: Only check locked fields if they are being updated.
    function ownerCanUpdateOwnProfile() {
      return (!('accountType' in request.resource.data) || request.resource.data.accountType == resource.data.accountType) &&
             (!('email' in request.resource.data) || request.resource.data.email == resource.data.email) &&
             (!('rating' in request.resource.data) || request.resource.data.rating == resource.data.rating) &&
             (!('reviewCount' in request.resource.data) || request.resource.data.reviewCount == resource.data.reviewCount) &&
             (!('isBanned' in request.resource.data) || request.resource.data.isBanned == resource.data.isBanned) &&
             (!('verificationStatus' in request.resource.data) || request.resource.data.verificationStatus == resource.data.verificationStatus) &&
             (!('verificationReason' in request.resource.data) || request.resource.data.verificationReason == resource.data.verificationReason) &&
             (!('isVerified' in request.resource.data) || request.resource.data.isVerified == resource.data.isVerified) &&
             (!('badgeVisible' in request.resource.data) || request.resource.data.badgeVisible == resource.data.badgeVisible);
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && ownerCanUpdateOwnProfile());
      allow delete: if isAdmin();

      match /portfolio/{photoId} {
        allow read: if isSignedIn();
        allow create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /notifications/{notificationId} {
        allow read, create, update, delete: if isOwner(userId) || isAdmin();
      }

      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() &&
          request.resource.data.reviewerId == currentUid() &&
          currentUid() != userId;
        allow update: if isAdmin() ||
          (isOwner(userId) &&
            request.resource.data.reviewerId == resource.data.reviewerId &&
            request.resource.data.rating == resource.data.rating &&
            request.resource.data.reviewText == resource.data.reviewText &&
            request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if isAdmin();
      }

      match /chat_sessions/{sessionId} {
        allow read, write: if isOwner(userId);
        match /messages/{messageId} {
          allow read, write: if isOwner(userId);
        }
      }
    }

    match /conversations/{conversationId} {
      allow read: if hasParticipantAccess(resource.data.participants);
      allow create: if hasParticipantAccess(request.resource.data.participants) &&
        isAllowedConversationPair(request.resource.data.participants);
      allow update: if hasParticipantAccess(resource.data.participants) &&
        request.resource.data.participants == resource.data.participants;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if hasParticipantAccess(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow create: if hasParticipantAccess(
            get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          ) &&
          request.resource.data.senderId == currentUid();
        allow update: if hasParticipantAccess(
          get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow delete: if isAdmin();
      }
    }

    match /admins/{adminId} {
      allow read: if (isSignedIn() && currentUid() == adminId) || isAdmin();
      allow write: if isAdmin();
    }

    match /reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reporterId == currentUid();
      allow read: if isAdmin() || resource.data.reporterId == currentUid();
      allow update, delete: if isAdmin();
    }
  }
}