rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isConversationParticipant(conversationId) {
      return isSignedIn() &&
        request.auth.uid in firestore.get(
          /databases/(default)/documents/conversations/$(conversationId)
        ).data.participants;
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /users/{userId}/documents/{fileName} {
      allow read, write: if isOwner(userId);
    }

    match /users/{userId}/portfolio/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /users/{userId}/marketplace_photos/{fileName} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    match /messages/{conversationId}/{fileName} {
      allow read, write: if isConversationParticipant(conversationId);
    }
  }
}
